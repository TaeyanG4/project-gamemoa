{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gamemoa-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gamemoa-d1",
      "database_id": "local-gamemoa-d1",
      "migrations_dir": "../../packages/db/migrations"
    }
  ]
}
