{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owogg-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "api.owogg.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "owogg-d1",
      "database_id": "4668dc75-0d25-43fa-9a8b-38bf78271655",
      "migrations_dir": "../../packages/db/migrations",
    },
  ],
  "vars": {
    "COMMIT_SHA": "dev",
  },
  // Capacity protection for write endpoints (see src/middleware/rateLimit.ts). 30 submissions
  // per 60s per session is far above human play — the shortest game round is 30 seconds — but
  // caps a submission loop before it can monopolize D1's serialized query throughput.
  // Limits are enforced per Cloudflare location, which is the right granularity here: the goal
  // is protecting each colo's share of DB throughput, not global exactness.
  // The binding is read optionally by the middleware, so removing this block degrades to
  // "unprotected" rather than breaking the deploy.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "triggers": {
    "crons": ["0 */6 * * *"],
  },
  // .wasm (satori's yoga.wasm, @resvg/resvg-wasm) is natively understood by Wrangler's bundler
  // without a rule. .ttf (the embedded rank-card font) needs an explicit "Data" rule to resolve
  // to an ArrayBuffer the same way — see src/types/assets.d.ts for the matching ambient types.
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
}
