{
  "name": "owogg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "generate:registry": "tsx scripts/generate-game-registry.ts",
    "generate:game": "tsx scripts/generate-game.ts",
    "generate:favicon": "tsx scripts/generate-favicon.ts",
    "architecture:check": "tsx scripts/verify-architecture.ts",
    "registry:check": "tsx scripts/check-registry.ts",
    "test:scripts": "node --import tsx --test scripts/**/*.test.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "smoke:prod": "tsx scripts/verify-production.ts",
    "auth:prod:check": "tsx scripts/check-auth-readiness.ts",
    "discord:commands:register": "tsx scripts/register-discord-commands.ts",
    "discord:commands:register:guild": "tsx scripts/register-discord-commands-guild.ts",
    "discord:commands:check": "tsx scripts/discord-commands-check.ts",
    "admin:password:hash": "tsx scripts/admin-password-hash.ts",
    "i18n:sync-check": "tsx scripts/check-i18n-sync.ts",
    "publish:official-games": "tsx scripts/publish-official-game-bundles.ts",
    "backfill:creator-canonical": "tsx scripts/run-creator-canonical-backfill.ts",
    "e2e": "tsx e2e/run.ts",
    "verify": "pnpm install --frozen-lockfile && pnpm format:check && pnpm architecture:check && pnpm registry:check && pnpm lint && pnpm typecheck && pnpm typecheck:scripts && pnpm test && pnpm test:scripts && pnpm build",
    "deploy": "pnpm --filter @owogg/api deploy && pnpm --filter @owogg/web deploy",
    "d1:migrate": "pnpm exec wrangler d1 migrations apply DB --local --config apps/api/wrangler.jsonc",
    "d1:migrate:prod": "pnpm exec wrangler d1 migrations apply DB --remote --config apps/api/wrangler.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@owogg/core": "workspace:*",
    "@owogg/db": "workspace:*",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fflate": "^0.8.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.23.12",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.25.0",
    "wrangler": "^4.121.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
