{
  "name": "gamemoa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "generate:registry": "tsx scripts/generate-game-registry.ts",
    "generate:game": "tsx scripts/generate-game.ts",
    "generate:favicon": "tsx scripts/generate-favicon.ts",
    "architecture:check": "tsx scripts/verify-architecture.ts",
    "registry:check": "tsx scripts/check-registry.ts",
    "smoke:prod": "tsx scripts/verify-production.ts",
    "auth:prod:check": "tsx scripts/check-auth-readiness.ts",
    "discord:commands:register": "tsx scripts/register-discord-commands.ts",
    "admin:password:hash": "tsx scripts/admin-password-hash.ts",
    "verify": "pnpm install --frozen-lockfile && pnpm format:check && pnpm architecture:check && pnpm registry:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "deploy": "pnpm --filter @gamemoa/api deploy && pnpm --filter @gamemoa/web deploy",
    "d1:migrate": "pnpm exec wrangler d1 migrations apply DB --local --config apps/api/wrangler.jsonc",
    "d1:migrate:prod": "pnpm exec wrangler d1 migrations apply DB --remote --config apps/api/wrangler.jsonc",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.23.12",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.25.0",
    "wrangler": "^4.121.0"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
